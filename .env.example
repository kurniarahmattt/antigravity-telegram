# =============================================================================
# antigravity-telegram — environment configuration
# Copy this file to `.env` and fill in your own values.
# Never commit a real `.env` to source control.
# =============================================================================

# ---- Telegram ---------------------------------------------------------------
# Token from @BotFather (https://t.me/botfather).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourOwn00000000

# Optional — bot username for display only.
TELEGRAM_BOT_USERNAME=my_agy_bot

# ---- Workspace --------------------------------------------------------------
# Base directory the bot is allowed to operate in. Subfolders here become
# "projects" selectable via /repo <name>. Must be an absolute path.
APPROVED_DIRECTORY=/path/to/your/projects

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Get yours by messaging @userinfobot, or send /whoami to the bot.
ALLOWED_USERS=111111111

# ---- agy CLI ----------------------------------------------------------------
# Path or command name for the Antigravity CLI.
AGY_BIN=agy

# Wall-clock timeout (seconds) per agy invocation.
AGY_TIMEOUT_SECONDS=300

# Pass --dangerously-skip-permissions when code mode is active.
# Required for unattended file edits in code mode. Has no effect in chat mode.
AGY_SKIP_PERMISSIONS=true

# Where agy stores its per-conversation protobuf files.
AGY_CONVERSATIONS_DIR=/home/user/.gemini/antigravity-cli/conversations

# ---- Storage ----------------------------------------------------------------
# SQLite database for per-user conversation tracking.
DATABASE_PATH=./data/agytg.sqlite

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
